{
  "name": "bamidelealy-analytics",
  "main": "analytics-worker.js",
  "compatibility_date": "2026-07-19",
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_KV",
      "id": "replace-with-production-kv-id",
      "preview_id": "replace-with-preview-kv-id"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://bamidelealy.com,http://127.0.0.1:8081,http://localhost:8081"
  }
}
